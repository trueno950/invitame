generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PackageStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// The invitation lifecycle (M5 A2): DRAFT, PUBLISHED, and terminal ARCHIVED. Milestone 4 wrote DRAFT and
// ARCHIVED; migration 2026111*_add_invitation_publication appends PUBLISHED, so PostgreSQL's physical
// order is DRAFT, ARCHIVED, PUBLISHED. No code compares invitation statuses ordinally.
enum InvitationStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
}

// The two kinds of invitation media (M8 S4). The stored labels are the contract's own; the Prisma names are only
// the client-side identifiers, so no code compares an enum name.
enum MediaAssetKind {
  MAIN_PHOTO @map("main-photo")
  GALLERY    @map("gallery")
}

// The lifecycle of one media asset (M8 S4): `deleted` marks a row whose object may still exist until the cleanup
// command removes it, so the delete is recoverable and idempotent.
enum MediaAssetStatus {
  STORED  @map("stored")
  DELETED @map("deleted")
}

// The state of one photo a guest uploaded (F8; L11.1, L11.3, L11.6). Every upload is `PENDING` and invisible to guests
// until the owner publishes it; `HIDDEN` is a published photo the owner took down again, which may be shown again. A
// photo never returns to `PENDING`, and a pending or hidden one is removed by the media retention cleanup after 30 days.
enum GuestPhotoStatus {
  PENDING
  PUBLISHED
  HIDDEN
}

// The lifecycle of one payment (M7 S1, S4). `pending` is what a checkout writes; a verified provider event moves it
// to `paid`, `failed`, or `expired`, and only `paid` becomes `refunded`. The domain state machine
// (`src/payments/domain/payment.ts`) is the rule; this enum is the guard that makes any other value unstorable.
enum PaymentStatus {
  pending  @map("pending")
  paid     @map("paid")
  failed   @map("failed")
  expired  @map("expired")
  refunded @map("refunded")
}

// The four state-changing support actions the administrator audit records (M9 T6; S4, S6, L9). Viewing a payment is
// deliberately absent: S6 decided that reading a payment writes no row. The labels are the domain's own
// (`domain/admin-action.ts`, `ADMIN_ACTION`), stored verbatim; migration 20261127120000_add_admin_actions creates the
// type, so any other value is unstorable.
enum AdminActionType {
  INVITATION_UNPUBLISHED
  ACCOUNT_DISABLED
  ACCOUNT_REACTIVATED
  SIGN_IN_CODE_RESENT
  SETTINGS_UPDATED
}

// The closed set of reasons an administrator gives (L8, L9, S6). `OTHER` is the one value that requires the note.
enum AdminActionReason {
  ABUSE
  OWNER_REQUEST
  PAYMENT_ERROR
  OTHER
}

// The two links one counted opening can come through (M9 T11; S7): the plain public page (`PUBLIC`) and one guest's
// personal link (`GUEST`). They are counted together and separately, and the stored labels are the API's own.
enum InvitationViewSource {
  PUBLIC
  GUEST
}

// Better Auth `user` model. Better Auth's `name` field is mapped onto `displayName`.
// `role` is server-side only and never accepted as client input.
model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(320)
  displayName      String?    @db.VarChar(120)
  status           UserStatus @default(ACTIVE)
  role             UserRole   @default(CUSTOMER)
  emailVerified    Boolean    @default(false)
  image            String?    @db.Text
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)

  sessions            Session[]
  accounts            Account[]
  twoFactor           TwoFactor?
  invitations         Invitation[]
  // The audit rows this account took as an administrator, and the ones that changed it (M9 T6; S6).
  adminActionsTaken   AdminAction[] @relation("AdminActionActor")
  adminActionsAgainst AdminAction[] @relation("AdminActionTarget")
}

// Better Auth `session` model: database sessions carried by the API cookie.
model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  token                String   @unique @db.Text
  expiresAt            DateTime @db.Timestamptz(6)
  ipAddress            String?  @db.Text
  userAgent            String?  @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
  // Project column, declared to Better Auth as a session additional field: whether this session was
  // opened with the second factor. Existing rows read false (S52).
  secondFactorVerified Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Better Auth `account` model: credential (password hash) or provider link per user.
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String    @db.Text
  providerId            String    @db.Text
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// Better Auth `verification` model: short-lived values such as email one-time codes.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([identifier])
}

// Better Auth two-factor plugin model: one encrypted TOTP secret and backup-code set per user.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @unique @db.Uuid
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Better Auth persistent rate-limit storage (`rateLimit.storage = "database"`).
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.Text
  count       Int
  lastRequest BigInt
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  key         String     @unique @db.VarChar(100)
  name        String     @db.VarChar(120)
  description String?    @db.Text
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  templates   Template[]
}

model Feature {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  packageFeatures PackageFeature[]
}

model Package {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  status          PackageStatus    @default(DRAFT)
  // How long a published invitation of this package stays live, counted from its publication instant, in whole days
  // (S1, S4). The seed gives each catalog package its own duration (30, 90, 180). The default is the basic month, so
  // every package stored before this column existed keeps a valid, documented lifetime instead of none. Migration
  // 20261130120000_add_package_duration_days adds the column with the same default and the CHECK constraint Prisma
  // cannot express, "Package_durationDays_positive" (durationDays > 0).
  durationDays    Int              @default(30)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  packageFeatures PackageFeature[]
  prices          PackagePrice[]
  invitations     Invitation[]
  payments        Payment[]
}

// A price of a package in one currency, as an integer amount in minor units (centavos for MXN). A price
// never changes: setting a new one retires the current row (`retiredAt`) and inserts another in one
// transaction, so the history stays. The currency allow-list (MXN today) lives in the API domain.
model PackagePrice {
  id          String    @id @default(uuid()) @db.Uuid
  packageId   String    @db.Uuid
  currency    String    @db.Char(3)
  amountMinor Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  retiredAt   DateTime? @db.Timestamptz(6)

  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  // Migration 20261109130000 adds what Prisma cannot express: the CHECK constraints
  // "PackagePrice_currency_format" (currency ~ '^[A-Z]{3}$') and "PackagePrice_amountMinor_non_negative"
  // (amountMinor >= 0), the partial unique index "PackagePrice_current_key" (one current price, retiredAt
  // IS NULL, per package and currency), and the "PackagePrice_immutable" trigger (packageId, currency,
  // amountMinor, and createdAt never change; retiredAt may be set once and never cleared or changed).
  @@index([packageId])
}

model PackageFeature {
  packageId String   @db.Uuid
  featureId String   @db.Uuid
  included  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([packageId, featureId])
  @@index([featureId])
}

model Template {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @db.Uuid
  key         String         @unique @db.VarChar(100)
  name        String         @db.VarChar(160)
  description String?        @db.Text
  status      TemplateStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  category Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions TemplateVersion[]

  @@index([categoryId])
}

model TemplateVersion {
  id            String                @id @default(uuid()) @db.Uuid
  templateId    String                @db.Uuid
  version       Int
  status        TemplateVersionStatus @default(DRAFT)
  componentKey  String                @map("component_key") @db.VarChar(100)
  schema        Json                  @db.JsonB
  configuration Json                  @db.JsonB
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)

  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  invitations Invitation[]

  // Migration 20261109120000 adds what Prisma cannot express: the partial unique index
  // "TemplateVersion_templateId_published_key" (one PUBLISHED version per template) and the
  // "TemplateVersion_status_transition" trigger (only DRAFT -> PUBLISHED and PUBLISHED -> RETIRED).
  @@unique([templateId, version])
}

// A creator's invitation draft (M4 T1; S2, S3, S5, S10, A3). It is pinned at creation to the published
// template version it renders, the package its entitlements are checked against, and its public slug; the owner,
// the package, and the slug never change, and the pinned version changes only while the invitation is a DRAFT and
// only to the PUBLISHED version of the same template (S5, S8.6). `content` is the bounded form data, always a JSON
// object.
// Migration 20261111214752_add_invitations adds what Prisma cannot express: the CHECK constraints
// "Invitation_slug_format", "Invitation_slug_length", "Invitation_content_object", and
// "Invitation_archivedAt_matches_status", and the "Invitation_pinned_fields_immutable" trigger.
// Migration 20261201120000_allow_draft_invitation_repin replaces that trigger's function so the narrow re-pin is
// allowed and every other change of `templateVersionId` is still refused with the same message.
// Migration 2026111*_add_invitation_publication adds "Invitation_publishedAt_matches_status" and keeps the
// archive check, which stays correct for three statuses.
// Migration 2026111*_add_invitation_features adds "timeZone" (NOT NULL with the default every existing row
// reads) and the one-to-one InvitationFeatureSettings table, plus the checks Prisma cannot express:
// "Invitation_timeZone_format" and "InvitationFeatureSettings_whatsappPhone_format".
model Invitation {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  templateVersionId String           @db.Uuid
  packageId         String           @db.Uuid
  slug              String           @unique @db.VarChar(60)
  status            InvitationStatus @default(DRAFT)
  content           Json             @default("{}") @db.JsonB
  // The IANA zone the guest's countdown and calendar links use. The allow-list lives in the API domain
  // (`domain/invitation-features.ts`, S4); the database checks the shape and the default.
  timeZone          String           @default("America/Mexico_City") @db.VarChar(64)
  // RSVP settings (M6 G1; S4): an optional deadline and a party limit of 1 to 10. The deadline is nullable, so
  // every row that existed before the migration keeps accepting responses; the limit defaults to 4 and migration
  // 20261117120000_add_rsvp_responses adds the CHECK constraint Prisma cannot express.
  rsvpDeadline      DateTime?        @db.Timestamptz(6)
  rsvpPartyLimit    Int              @default(4)
  archivedAt        DateTime?        @db.Timestamptz(6)
  // Set exactly while the status is PUBLISHED: unpublishing and archiving clear it (S7, A2).
  publishedAt       DateTime?        @db.Timestamptz(6)
  // The first instant this invitation was ever published, or NULL while it never was (T2, S3). Unlike
  // `publishedAt`, nothing clears it: the refund rule reads it to refuse «Sin reembolso tras publicar» after an
  // unpublish or an archive. Migration 20261124120000_add_invitation_first_published_at adds it and the CHECK
  // constraint Prisma cannot express, `Invitation_firstPublishedAt_when_published`.
  firstPublishedAt  DateTime?        @db.Timestamptz(6)
  // The instant a refund claim asked the provider, or NULL while none did (T2, S3). Nothing clears it, so a retry
  // re-sends the same idempotent refund; publishing refuses this row while it carries one (migration 20261124130000).
  refundRequestedAt DateTime?        @db.Timestamptz(6)
  // The instant this published invitation expires: its publication plus its pinned package's duration (S1, S2). Set
  // by the publication write and cleared by unpublish and archive, so it is NULL exactly while the invitation is not
  // published. After it passes the invitation stays visible read-only and its RSVP closes; nothing extends it (S3).
  expiresAt         DateTime?        @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  owner              User                       @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  templateVersion    TemplateVersion            @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  package            Package                    @relation(fields: [packageId], references: [id], onDelete: Restrict)
  featureSettings    InvitationFeatureSettings?
  places             InvitationPlace[]
  rsvpResponses      RsvpResponse[]
  guests             Guest[]
  mediaAssets        MediaAsset[]
  payments           Payment[]
  adminActions       AdminAction[]
  views              InvitationView[]
  reminderDeliveries ReminderDelivery[]
  guestbookEntries   GuestbookEntry[]
  guestPhotos        GuestPhoto[]

  @@index([ownerId])
  // The administrator's status view (M9 T2; S1) reads a page newest first, optionally filtered by one status, so
  // migration 20261125120000_add_invitation_status_created_at_index adds this index for the filtered page.
  @@index([status, createdAt])
  // The same view with no status filter reads the whole table newest first, and the key-set cursor continues on
  // `id`, so migration 20261126120000_add_invitation_created_at_id_index adds this second index for that page (T5).
  @@index([createdAt, id])
  // The analytics funnel (M9 T11; S2) aggregates first publications by day over one bounded window, so migration
  // 20261128130000_add_analytics_indexes adds this index concurrently for that range scan.
  @@index([firstPublishedAt])
}

// Feature data of one invitation, stored apart from the template (F1; S3, S4): changing the template never
// touches it. The invitation id is the primary key, so an invitation has at most one row, and the foreign key
// is ON DELETE RESTRICT because an invitation is never hard-deleted here — archiving is the only terminal
// lifecycle write — matching every other invitation reference.
// Migration 2026111*_add_invitation_features adds what Prisma cannot express: the
// "InvitationFeatureSettings_whatsappPhone_format" check (NULL or an E.164 number, `^\+[1-9][0-9]{7,14}$`).
// Migration 2026111*_add_invitation_features_playlist_url adds "playlistUrl" and its
// "InvitationFeatureSettings_playlistUrl_https" check (NULL or a value that starts with `https://`).
// Migration 20261122120000_add_invitation_feature_music_metadata adds "playlistTitle" and "playlistCoverUrl",
// with "InvitationFeatureSettings_playlistCoverUrl_https" (NULL or a value that starts with `https://`).
// Migration 20261202120000_add_invitation_itinerary adds the nullable `itinerary` JSONB column, and the same
// migration inserts the `ITINERARY` catalog feature row and its links to the basic, premium, and deluxe packages.
// Migration 20261203120000_add_invitation_gift_registry adds the nullable `giftRegistry` JSONB column; the
// `GIFT_REGISTRY` catalog key already existed, so that migration changes no catalog row.
// Migration 20261205120000_add_invitation_lodging adds the nullable `lodging` JSONB column, and the same migration
// inserts the `LODGING` catalog feature row and its links to the premium and deluxe packages.
// Migration 20261207120000_add_whatsapp_reminders adds the nullable `reminders` JSONB column, the `ReminderDelivery`
// table, and the `WHATSAPP_REMINDERS` catalog feature row with its link to the deluxe package.
// Migration 20261211120000_add_invitation_livestream adds the nullable `livestream` JSONB column, and the same
// migration inserts the `LIVESTREAM` catalog feature row and its links to the premium and deluxe packages.
// Migration 20261212120000_add_invitation_opening_animation adds the `openingAnimation` boolean column (NOT NULL,
// default true), and the same migration inserts the `OPENING_ANIMATION` catalog feature row and its links to every
// seeded package.
model InvitationFeatureSettings {
  invitationId     String   @id @db.Uuid
  // E.164: `+` and eight to fifteen digits. Null while the owner has not set one (S4).
  whatsappPhone    String?  @db.VarChar(16)
  // The playlist link the guest's music button opens (F6; S7): an `https` URL on an allow-listed music host,
  // at most 500 characters, or NULL while the owner has not pasted one. The host allow-list is the API
  // domain's (`domain/invitation-features.ts`); the column checks the scheme and the width.
  playlistUrl      String?  @db.VarChar(500)
  // The title and the cover the provider's public oEmbed answer named when that link was saved, at most 200 and
  // 500 characters, or NULL when the provider named none or the lookup did not run (S2). The image-host
  // allow-list and the trimming are the API domain's; the cover column also checks the scheme.
  playlistTitle    String?  @db.VarChar(200)
  playlistCoverUrl String?  @db.VarChar(500)
  // The itinerary of the day (F1; S2.1, L3.1): the versioned presentation payload
  // `{ "version": 1, "items": [{ time, title, place?, address? }] }` with 1 to 15 moments, or NULL while the owner
  // has not filled one. Bounded, versioned, presentation data only: no image, no link, no provider payload. The domain
  // (`domain/invitation-features.ts`) is the authority on the shape; the column stores it as JSONB and nothing else,
  // and no CHECK can state it.
  itinerary        Json?    @db.JsonB
  // The gift registry of the celebration (F2; S2.2, L4.1): the versioned presentation payload
  // `{ "version": 1, "stores": [{ name, reference?, url }], "transfer"?: { bank, holder, clabe }, "envelopes", "note"? }`
  // with 0 to 8 stores, or NULL while the owner has not filled one. Bounded, versioned, presentation data only: no
  // image, no provider payload, no query-critical field. The domain (`domain/invitation-gift-registry.ts`) is the
  // authority on the shape, the CLABE included; the column stores it as JSONB and nothing else, and no CHECK can
  // state it. An older invitation's `content.giftRegistry` text stays untouched; the public read withholds it while
  // this payload has something to show (L4.3).
  giftRegistry     Json?    @db.JsonB
  // The lodging and transport of the celebration (F4; S2.4, L7.1): the versioned presentation payload
  // `{ "version": 1, "hotels": [{ name, distance?, price?, groupCode?, bookingUrl?, address? }], "transport"? }`
  // with 0 to 6 hotels, or NULL while the owner has not filled one. Bounded, versioned, presentation data only: no
  // image, no provider payload, no query-critical field. The domain (`domain/invitation-lodging.ts`) is the authority
  // on the shape, the `https` booking link included; the column stores it as JSONB and nothing else, and no CHECK can
  // state it.
  lodging          Json?    @db.JsonB
  // The WhatsApp reminder switches of the invitation (F6; S2.6, S6, L9.1): the versioned payload
  // `{ "version": 1, "pendingRsvp": boolean, "eventEve": boolean }`, or NULL while the owner switched nothing on. It
  // is bounded, versioned, presentation data that decides *whether* a reminder is sent; it carries no phone, no
  // provider, no credential, and no delivery state. The domain (`domain/invitation-reminders.ts`) is the authority on
  // the shape, the column stores it as JSONB, and every attempt lives in `ReminderDelivery` instead.
  reminders        Json?    @db.JsonB
  // The livestream of the celebration (F9; S2.9, L12.1): the versioned presentation payload
  // `{ "version": 1, "url": "https://…", "note"? }` with an `https` link of at most 500 characters and an optional note
  // of at most 120, or NULL while the owner has not pasted one. Bounded, versioned, presentation data only: no embed
  // markup, no provider payload, no query-critical field. The domain (`domain/invitation-livestream.ts`) is the authority
  // on the shape and on which link may be embedded; the column stores it as JSONB and nothing else, and no CHECK can
  // state it.
  livestream       Json?    @db.JsonB
  // The opening animation switch (F10; S2.10, L14.3): whether the guest page of this published invitation draws the
  // envelope with the seal before showing it. It defaults to true, so every feature-settings row written before the
  // switch existed, and every invitation that never saved one, plays it; an owner who switched it off stores false and
  // the page shows the invitation directly. The pinned package's `OPENING_ANIMATION` key is the other half of the gate:
  // the public read answers the animation only while the catalog grants the key and this column is true.
  openingAnimation Boolean  @default(true)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
}

// Which WhatsApp reminders the owner let the invitation send (F6; S2.6, S6). The switches are data, so the catalog can
// grant the capability and the owner can still keep it off, and a package upgrade never sends anything by itself.
enum ReminderKind {
  // Seven days before the RSVP deadline, for the guests who have not answered yet (L9.1).
  PENDING_RSVP_7D
  // Two days before the RSVP deadline, for the guests who still have not answered (L9.1).
  PENDING_RSVP_2D
  // One day before the celebration, for the guests expected that day (L9.1).
  EVENT_EVE
}

// What one attempt came to (F6; L9.4). `pending` is claimed by a run before the message leaves; the outcome replaces
// it. A row is never deleted and never rewritten into another attempt: the day it belongs to is part of its key.
enum ReminderDeliveryStatus {
  pending
  sent
  skipped
  failed
}

// One attempt to deliver one reminder (F6; S2.6, S6, L9.4). The four columns of the unique index are the identity of an
// attempt — the invitation, the guest, the kind, and the calendar day of the invitation's own zone — so a second run of
// the same day records nothing new and sends nothing twice. `status` and `reason` are the outcome: `sent`, `skipped`
// with a stable reason (`not_configured` while no provider exists, S6), or `failed` with the sender's stable reason.
// No phone, name, or message body is stored here: the row says that an attempt happened and how it ended, and the
// guest's own data stays in the guest list. Migration 20261207120000_add_whatsapp_reminders adds the table, its unique
// index, the nullable `reminders` column, and the `WHATSAPP_REMINDERS` catalog key with its Deluxe link.
model ReminderDelivery {
  id           String                 @id @default(uuid()) @db.Uuid
  invitationId String                 @db.Uuid
  guestId      String                 @db.Uuid
  kind         ReminderKind
  // The calendar day the reminder belongs to, as the invitation's own zone reads it (L9.4), stored as a DATE so two
  // runs on the same day agree whatever hour they start at.
  dueDate      DateTime               @db.Date
  status       ReminderDeliveryStatus @default(pending)
  // The stable reason of a skipped or failed attempt, at most 40 characters; NULL for a sent one.
  reason       String?                @db.VarChar(40)
  // When the run claimed the attempt, which is what tells one day's run from the next.
  attemptedAt  DateTime               @db.Timestamptz(6)
  createdAt    DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime               @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  // Removing a guest removes its recorded attempts (F6; review R3-001); the invitation stays RESTRICT.
  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([invitationId, guestId, kind, dueDate])
  // The owner's own page and any later report read the attempts of one invitation newest first, and the command
  // reads nothing else.
  @@index([invitationId, attemptedAt])
}

// The precise location of one address field of one invitation (S1, S2). The owner picks a suggestion from the
// geocoder, the address text is stored in the template content as always, and this row remembers the point the text
// referred to at that moment. It is keyed by the invitation and the content field name, so one address field has at
// most one point: a second choice replaces the first instead of adding another row. The reference is ON DELETE
// RESTRICT, because an invitation is never hard-deleted here (archiving is its only terminal lifecycle write).
// Migration 20261123120000_add_invitation_places adds what Prisma cannot express: the CHECK constraints
// "InvitationPlace_lat_range" (-90..90) and "InvitationPlace_lng_range" (-180..180). The public read shows a point
// only while the address text still equals `label` (domain/invitation-place.ts), so no column is dropped on rewrite.
model InvitationPlace {
  invitationId String   @db.Uuid
  // The content field name of the address, such as `address` or `ceremonyAddress` (S2); the API derives it from the
  // pinned template version schema and never from a template name.
  field        String   @db.VarChar(64)
  // The label the geocoder answered when the owner chose the suggestion, at most 300 characters. It is the text the
  // content field holds at that moment, which is what makes a later rewrite drop the point.
  label        String   @db.VarChar(300)
  // The point, range-checked by the migration's CHECK constraints; the domain refuses the same bounds first.
  lat          Float    @db.DoublePrecision
  lng          Float    @db.DoublePrecision
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@id([invitationId, field])
}

// One guest's attendance answer to one invitation (M6 G1; S1, S4). The row is tied to the invitation, which is
// never hard-deleted here (archiving is its only terminal lifecycle write), so the reference is ON DELETE RESTRICT.
// `dedupeKey` is the normalized name and normalized phone: the unique index on `(invitationId, dedupeKey)` is what
// makes an open-form retry an update instead of a duplicate and what lets two concurrent identical submissions end
// in one row. A personal-link answer instead carries `guestId` (`guest|<guestId>` as its dedupe key) and upserts on
// that unique column, which the guest table and its nullable reference arrive with (M6 G2).
// The response carries bounded values only — a name of 1 to 80 characters, an attending flag, a party size of 0 to
// 10 (0 exactly when declined), an optional E.164 phone, an optional message of at most 280 characters, and the
// timestamps — and no free-form JSONB.
// Migration 20261117120000_add_rsvp_responses adds what Prisma cannot express: the CHECK constraints
// "RsvpResponse_name_length", "RsvpResponse_partySize_range", "RsvpResponse_partySize_matches_attending",
// "RsvpResponse_phone_format", and "RsvpResponse_message_length", plus "Invitation_rsvpPartyLimit_range".
// Migration 20261204120000_add_rsvp_companions adds the nullable `companions` JSONB and `dietaryNotes` columns: the
// bounded companions of the party (`[{ name, child }]`, one entry per extra person while attending) and the dietary
// restrictions the guest named. Both are additive, so every answer stored before them reads NULL and renders exactly
// as it did.
model RsvpResponse {
  id           String   @id @default(uuid()) @db.Uuid
  invitationId String   @db.Uuid
  // The guest a personal-link answer belongs to, or NULL for an answer to the open form (M6 G2; S4). The unique
  // index on this column is what makes one guest have at most one answer; the foreign key is ON DELETE RESTRICT
  // and the guest's own removal deletes the answer in the same statement.
  guestId      String?  @unique @db.Uuid
  // The dedupe-normalized name and the normalized phone, separated by `|` (at most 97 characters).
  dedupeKey    String   @db.VarChar(200)
  name         String   @db.VarChar(80)
  attending    Boolean
  // 0 when the guest declined; otherwise 1 to the invitation's `rsvpPartyLimit` (the domain checks the limit).
  partySize    Int
  // The people who come with the guest (F3; L6.1): the bounded presentation payload `[{ name, child }]` with one entry
  // per extra person, or NULL for an answer stored before it existed. The stored `partySize` stays the source of the
  // count — `companions.length` is exactly `partySize - 1` while attending and 0 otherwise — so the domain
  // (`domain/invitation-rsvp.ts`) is the authority on the shape, and no CHECK can state it. A name is at most 60
  // characters and blank is valid, so a guest may confirm a count without every name; `child` is what the owner's
  // totals count apart.
  companions   Json?    @db.JsonB
  // The dietary restrictions of the party (F3; L6.1), trimmed, at most 300 characters, or NULL when the guest named
  // none. Plain text only: the page renders it as text, never as markup.
  dietaryNotes String?  @db.VarChar(300)
  // E.164 or NULL; the domain normalizes a Mexican ten-digit number to `+52…` like the WhatsApp contact does.
  phone        String?  @db.VarChar(16)
  message      String?  @db.VarChar(280)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([invitationId, dedupeKey])
}

// One uploaded photo of one invitation (M8 S4). The binary never lives here: `storageKey` names the object in the
// storage adapter, and it is unique because it embeds the generated asset id. `kind` is `main-photo` (at most one
// current per invitation, enforced by the partial unique index the migration adds) or `gallery` (ordered by
// `position`, at most 12 stored); an invitation holds at most 40 stored assets, enforced by the application in the
// transaction that writes a row, serialized on the invitation. `alt` is optional and at most 120 characters.
// Migration 20261120120000_add_media_assets adds what Prisma cannot express: the CHECK constraints
// "MediaAsset_byteSize_range", "MediaAsset_dimensions_range", "MediaAsset_mime_webp",
// "MediaAsset_position_matches_kind", "MediaAsset_alt_length", and "MediaAsset_storageKey_format", plus the partial
// unique index "MediaAsset_one_stored_main_photo" and the index on (invitationId, kind, status, position).
model MediaAsset {
  id           String           @id @default(uuid()) @db.Uuid
  invitationId String           @db.Uuid
  kind         MediaAssetKind
  // `invitations/<invitationId>/<assetId>.webp`: built by the API from validated ids only (S4).
  storageKey   String           @unique @db.VarChar(200)
  mime         String           @default("image/webp") @db.VarChar(64)
  byteSize     Int
  width        Int
  height       Int
  // The gallery order; NULL for the one main photo (S4). The CHECK keeps the two kinds apart.
  position     Int?
  alt          String?          @db.VarChar(120)
  status       MediaAssetStatus @default(STORED)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([invitationId, kind, status, position])
}

// One person on an invitation's guest list (M6 G2; S1, S3, S4). The owner reaches a guest only through the
// invitation that pins the package granting `GUEST_LIST`, so there is no owner column here: the adapter's every
// statement joins the invitation and names its owner. `tokenHash` is the SHA-256 hex digest of the guest's personal
// token, the only form ever stored, and its unique index is what a personal link is looked up through. The token
// itself is 128 bits drawn by the platform's cryptographic random source and is answered once, on creation or
// rotation. The row carries bounded values only: a name of 1 to 80 characters, 1 to 10 seats, an optional E.164
// phone, an optional note of at most 200 characters, an optional table of at most 12 characters (F5), and the
// check-in instant the owner's QR scan sets once.
// Migration 20261118120000_add_guests adds what Prisma cannot express: the CHECK constraints
// "Guest_name_length", "Guest_seats_range", "Guest_phone_format", "Guest_note_length", and
// "Guest_tokenHash_format", plus the RsvpResponse "guestId" column and its unique index. Migration
// 20261206120000_add_guest_table_label adds the table's own CHECK, "Guest_tableLabel_length".
model Guest {
  id            String    @id @default(uuid()) @db.Uuid
  invitationId  String    @db.Uuid
  name          String    @db.VarChar(80)
  // The party this guest may confirm, 1 to 10; the domain refuses anything else.
  seats         Int
  phone         String?   @db.VarChar(16)
  note          String?   @db.VarChar(200)
  // The table the owner assigned for the guest's access pass (F5; L8.1, L8.4): 1 to 12 trimmed characters, e.g. «7»
  // or «Principal», or NULL when none is assigned. A blank value is stored as NULL, and the migration's CHECK
  // "Guest_tableLabel_length" repeats the bound.
  tableLabel    String?   @db.VarChar(12)
  // The SHA-256 hex digest of the personal token: the only form stored, unique, and what a link looks up.
  tokenHash     String    @unique @db.VarChar(64)
  tokenIssuedAt DateTime  @db.Timestamptz(6)
  // When the owner first checked this guest in, or NULL while not checked in. A repeated scan keeps the first.
  checkedInAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  invitation         Invitation         @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  rsvpResponse       RsvpResponse?
  // The reminders this guest already received, one row per kind and day (F6; L9.4).
  reminderDeliveries ReminderDelivery[]

  @@index([invitationId])
}

// One message a guest signed in one invitation's guestbook (F7; S2.7, L10.1). The name and the message are plain text
// the guest typed, trimmed and bounded by the API domain (`domain/invitation-guestbook.ts`); the page renders them as
// text, so nothing becomes markup and no URL becomes a link. `hidden` is the owner's only moderation: false is
// published at once, true keeps the entry stored and takes it off the guest's wall, and either can be set again, so
// nothing a guest wrote is ever deleted by the guest. The reference to the invitation is ON DELETE RESTRICT like every
// other invitation reference, because an invitation is archived and never hard-deleted here; the guestbook therefore
// never keeps the owner from an existing operation (L24). Migration 20261209120000_add_guestbook adds the table, the
// length CHECK constraints Prisma cannot express, its read index, and the `GUESTBOOK` catalog key with its links to the
// premium and deluxe packages.
model GuestbookEntry {
  id           String   @id @default(uuid()) @db.Uuid
  invitationId String   @db.Uuid
  // The signature: 1 to 60 trimmed characters, checked by "GuestbookEntry_authorName_length".
  authorName   String   @db.VarChar(60)
  // The message: 1 to 500 trimmed characters, checked by "GuestbookEntry_message_length".
  message      String   @db.VarChar(500)
  // False publishes the entry at once; true hides it from the wall and keeps it for the owner (L10.6).
  hidden       Boolean  @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  // The guest wall reads one invitation's visible entries newest first; the owner's screen reads them all in the same
  // order, so one index serves both reads.
  @@index([invitationId, hidden, createdAt])
}

// One photo a guest uploaded to an invitation's album (F8; S2.8, L11.1). The binary never lives here: the row names its
// object by `storageKey` under the same `invitations/<invitationId>/<photoId>.webp` key space as the owner's own media,
// so one storage adapter, one serving route, and one cleanup scan serve both. `status` is PENDING until the owner
// reviews the photo; `reviewedAt` is the instant they published or hid it and stays NULL while it is pending. The
// uploader name is optional plain text of 1 to 60 trimmed characters, so a guest may stay anonymous.
// Migration 20261210120000_add_guest_album adds what Prisma cannot express: the CHECK constraints
// "GuestPhoto_storageKey_format", "GuestPhoto_uploaderName_length", and
// "GuestPhoto_reviewedAt_matches_status" (PENDING if and only if `reviewedAt` is NULL), plus the index the retention
// scan and the owner's read use.
model GuestPhoto {
  id           String           @id @default(uuid()) @db.Uuid
  invitationId String           @db.Uuid
  // The object of this photo: `invitations/<invitationId>/<photoId>.webp`, built from validated ids only.
  storageKey   String           @unique @db.VarChar(200)
  status       GuestPhotoStatus @default(PENDING)
  uploaderName String?          @db.VarChar(60)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  reviewedAt   DateTime?        @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  // The public read and the owner's screen both read one invitation's photos newest first, filtered by status or not,
  // so one index serves both; the retention scan filters by status and the state instant.
  @@index([invitationId, status, createdAt])
  @@index([status, createdAt])
}

// One checkout intent for one invitation (M7 S1, S4). `amountMinor` and `currency` are the snapshot of the
// package's price at the moment the payment was created: the catalog may retire that price and publish another,
// and this row keeps the amount the owner actually saw. `provider` is the adapter key (never a credential) and
// `providerReference` is the provider's own identifier of the checkout, unique per provider and NULL until the
// adapter has created it. `idempotencyKey` is the server-generated key the adapter passes so a retried checkout
// asks the provider for the same session instead of a second one. `paidAt` is the API's own receipt instant (the
// instant a verified `paid` event was applied), never a provider-supplied time in a money-relevant column.
// Migration 20261121120000_add_payments adds what Prisma cannot express: the CHECK constraints
// "Payment_amountMinor_non_negative", "Payment_currency_format", and "Payment_paidAt_matches_status", and the
// partial unique index "Payment_one_pending_key" (one `pending` payment per invitation) that makes two
// simultaneous checkouts converge on one row.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  invitationId      String        @db.Uuid
  // The package whose price this payment bought; the entitlement rule requires this to match the invitation's.
  packageId         String        @db.Uuid
  amountMinor       Int
  currency          String        @db.Char(3)
  status            PaymentStatus @default(pending)
  provider          String        @db.VarChar(40)
  providerReference String?       @db.VarChar(200)
  idempotencyKey    String        @unique @db.VarChar(100)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  paidAt            DateTime?     @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  invitation Invitation     @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  package    Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  events     PaymentEvent[]

  @@unique([provider, providerReference])
  @@index([invitationId, status])
  // The analytics funnel (M9 T11; S2) aggregates checkouts started by creation day and approved payments by `paidAt`
  // over one bounded window, so migration 20261128130000_add_analytics_indexes adds both indexes concurrently.
  @@index([createdAt])
  @@index([paidAt])
}

// One received provider event (M7 S1, S4): the normalized type, the provider's own event id, when the API received
// and processed it, what the intake decided, and the SHA-256 hex digest of the raw payload. The raw payload is
// never stored: it can carry a payer's name, e-mail address, or card metadata, and the normalized event plus the
// digest is everything a replay investigation needs. `(provider, providerEventId)` is unique, so a retried or
// duplicated delivery inserts nothing and is answered as a no-op. `paymentId` is NULL for a signed event about a
// provider reference this API does not know, which is recorded and ignored rather than dropped.
// Migration 20261121120000_add_payments adds what Prisma cannot express: the CHECK constraints
// "PaymentEvent_outcome_allowed", "PaymentEvent_type_allowed", and "PaymentEvent_payloadSha256_format" (a
// lowercase SHA-256 hex digest), plus the index on `paymentId`.
model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String?   @db.Uuid
  provider        String    @db.VarChar(40)
  providerEventId String    @db.VarChar(200)
  type            String    @db.VarChar(40)
  receivedAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)
  // The decision the intake took for this delivery, written when the row is inserted and corrected to
  // `ignored_transition` if a concurrent delivery won the guarded transition.
  outcome         String    @db.VarChar(40)
  payloadSha256   String    @db.Char(64)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId])
}

// One counted opening of an invitation link (M9 T11; S2, S3, S7, L12): the invitation, the calendar day in
// `America/Mexico_City`, the link it came through (`PUBLIC` or `GUEST`), and how many openings that pair counted. The
// composite primary key is the upsert's conflict target, so an increment is one statement that never duplicates. It
// stores nothing about the visitor — no IP address, user agent, referrer, cookie, session, token, or slug — and the
// `invitationId` reference is ON DELETE RESTRICT like every other invitation reference. Migration
// 20261128120000_add_invitation_views adds what Prisma cannot express: the `InvitationView_count_non_negative` check.
// Rows older than the retention window (ninety days, S3) are deleted by `pnpm analytics:retention`.
model InvitationView {
  invitationId String               @db.Uuid
  day          DateTime             @db.Date
  source       InvitationViewSource
  // The openings counted for this pair; the API only ever increments it.
  count        Int                  @default(0)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@id([invitationId, day, source])
  // The retention delete and both window reads filter by day, which the primary key cannot serve.
  @@index([day])
}

// One append-only audit row per state-changing support action (M9 T6; S4, S6, L9): who acted, what they did, why, and
// which target they changed. It carries no email address, client address, or provider payload. The `admin` module
// owns this table and only `AdminActionRecorder.record(tx, entry)` writes it, through the caller's own transaction, so
// the change and its audit row commit together (L9 «Misma transacción»); the webhook-style side effect of resending
// a code is recorded before the request, never after it.
// Migration 20261127120000_add_admin_actions adds what Prisma cannot express: the CHECK constraints
// "AdminAction_note_length", "AdminAction_note_required_for_other", "AdminAction_exactly_one_target", and
// "AdminAction_target_matches_action", plus the "AdminAction_append_only" trigger, which refuses every UPDATE and
// DELETE so that a stored row is final. Migration 20261129120050_add_settings_admin_action_type adds the
// SETTINGS_UPDATED label (M9 T13; S5, S8, L15), and 20261129120100_add_settings_admin_action relaxes the two target
// checks: the one platform-wide action names no target, while every other action keeps exactly the target it names.
model AdminAction {
  id           String            @id @default(uuid()) @db.Uuid
  // The administrator who took the action, taken from the session and never from client input. ON DELETE RESTRICT:
  // the audit history outlives any attempt to remove the account that wrote it.
  adminUserId  String            @db.Uuid
  action       AdminActionType
  reason       AdminActionReason
  // Optional and trimmed, at most 500 characters; required and non-blank while the reason is OTHER.
  note         String?           @db.VarChar(500)
  // The account the three account actions changed; NULL for INVITATION_UNPUBLISHED and SETTINGS_UPDATED. The CHECK
  // constraints keep it XOR with `invitationId`, and keep the pair matching `action`.
  targetUserId String?           @db.Uuid
  // The invitation INVITATION_UNPUBLISHED changed; NULL for the three account actions and for SETTINGS_UPDATED.
  invitationId String?           @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(6)

  adminUser  User        @relation("AdminActionActor", fields: [adminUserId], references: [id], onDelete: Restrict)
  targetUser User?       @relation("AdminActionTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  // The audit view reads newest first and continues on `id`; the two target indexes serve the per-target history.
  @@index([createdAt, id])
  @@index([targetUserId])
  @@index([invitationId])
}

// The administrator's operational settings (M9 T13; S5, S8, L15): exactly one row, whose `id` is the literal
// 'default', seeded by the migration with the limits the code used before this slice so nothing changes on deploy. The
// `settings` module owns this table. Every consumer (invitations: the RSVP limits, the place search, the analytics
// default window; media: the gallery, the stored assets, the upload size) reads it through
// `OPERATIONAL_SETTINGS_READER.current()` at the moment it checks a limit, so a save takes effect on the next check and
// a lowered limit only stops what is added afterwards: nothing stored is deleted, hidden, or rewritten (S8).
// Migration 20261129120000_add_operational_settings adds what Prisma cannot express: the single-row CHECK on `id`, a
// CHECK bound on every column, and the two cross-field checks ("rsvpDefaultPartyLimit" <= "rsvpMaxPartyLimit" and
// "storedAssetLimit" >= "galleryPhotoLimit" + 1), plus the one seeded row.
model OperationalSettings {
  id String @id @db.VarChar(7)

  // The party limit a new invitation starts with, and the widest party an owner may set and a guest may submit (S5).
  rsvpDefaultPartyLimit      Int
  rsvpMaxPartyLimit          Int
  // How many gallery photos, and how many stored assets of both kinds together, one invitation may hold (S5).
  galleryPhotoLimit          Int
  storedAssetLimit           Int
  // The largest upload the API accepts, in whole megabytes; the upload route's static body cap is 16 MB (S5).
  maxUploadMegabytes         Int
  // How many place suggestions the owner sees, and the analytics window a request that names no bound reads (S5).
  placeSearchResultLimit     Int
  analyticsDefaultWindowDays Int

  // The instant of the last save; the panel answers it and nothing else reads it.
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}
