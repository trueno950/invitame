generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum PackageStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// The invitation lifecycle (M5 A2): DRAFT, PUBLISHED, and terminal ARCHIVED. Milestone 4 wrote DRAFT and
// ARCHIVED; migration 2026111*_add_invitation_publication appends PUBLISHED, so PostgreSQL's physical
// order is DRAFT, ARCHIVED, PUBLISHED. No code compares invitation statuses ordinally.
enum InvitationStatus {
  DRAFT
  ARCHIVED
  PUBLISHED
}

// The two kinds of invitation media (M8 S4). The stored labels are the contract's own; the Prisma names are only
// the client-side identifiers, so no code compares an enum name.
enum MediaAssetKind {
  MAIN_PHOTO @map("main-photo")
  GALLERY    @map("gallery")
}

// The lifecycle of one media asset (M8 S4): `deleted` marks a row whose object may still exist until the cleanup
// command removes it, so the delete is recoverable and idempotent.
enum MediaAssetStatus {
  STORED  @map("stored")
  DELETED @map("deleted")
}

// The lifecycle of one payment (M7 S1, S4). `pending` is what a checkout writes; a verified provider event moves it
// to `paid`, `failed`, or `expired`, and only `paid` becomes `refunded`. The domain state machine
// (`src/payments/domain/payment.ts`) is the rule; this enum is the guard that makes any other value unstorable.
enum PaymentStatus {
  pending  @map("pending")
  paid     @map("paid")
  failed   @map("failed")
  expired  @map("expired")
  refunded @map("refunded")
}

// Better Auth `user` model. Better Auth's `name` field is mapped onto `displayName`.
// `role` is server-side only and never accepted as client input.
model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique @db.VarChar(320)
  displayName      String?    @db.VarChar(120)
  status           UserStatus @default(ACTIVE)
  role             UserRole   @default(CUSTOMER)
  emailVerified    Boolean    @default(false)
  image            String?    @db.Text
  twoFactorEnabled Boolean    @default(false)
  createdAt        DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @db.Timestamptz(6)

  sessions    Session[]
  accounts    Account[]
  twoFactor   TwoFactor?
  invitations Invitation[]
}

// Better Auth `session` model: database sessions carried by the API cookie.
model Session {
  id                   String   @id @default(uuid()) @db.Uuid
  userId               String   @db.Uuid
  token                String   @unique @db.Text
  expiresAt            DateTime @db.Timestamptz(6)
  ipAddress            String?  @db.Text
  userAgent            String?  @db.Text
  createdAt            DateTime @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @db.Timestamptz(6)
  // Project column, declared to Better Auth as a session additional field: whether this session was
  // opened with the second factor. Existing rows read false (S52).
  secondFactorVerified Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Better Auth `account` model: credential (password hash) or provider link per user.
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  accountId             String    @db.Text
  providerId            String    @db.Text
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

// Better Auth `verification` model: short-lived values such as email one-time codes.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([identifier])
}

// Better Auth two-factor plugin model: one encrypted TOTP secret and backup-code set per user.
model TwoFactor {
  id                      String    @id @default(uuid()) @db.Uuid
  userId                  String    @unique @db.Uuid
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime? @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Better Auth persistent rate-limit storage (`rateLimit.storage = "database"`).
model RateLimit {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique @db.Text
  count       Int
  lastRequest BigInt
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  key         String     @unique @db.VarChar(100)
  name        String     @db.VarChar(120)
  description String?    @db.Text
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  templates   Template[]
}

model Feature {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  packageFeatures PackageFeature[]
}

model Package {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  status          PackageStatus    @default(DRAFT)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  packageFeatures PackageFeature[]
  prices          PackagePrice[]
  invitations     Invitation[]
  payments        Payment[]
}

// A price of a package in one currency, as an integer amount in minor units (centavos for MXN). A price
// never changes: setting a new one retires the current row (`retiredAt`) and inserts another in one
// transaction, so the history stays. The currency allow-list (MXN today) lives in the API domain.
model PackagePrice {
  id          String    @id @default(uuid()) @db.Uuid
  packageId   String    @db.Uuid
  currency    String    @db.Char(3)
  amountMinor Int
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  retiredAt   DateTime? @db.Timestamptz(6)

  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  // Migration 20261109130000 adds what Prisma cannot express: the CHECK constraints
  // "PackagePrice_currency_format" (currency ~ '^[A-Z]{3}$') and "PackagePrice_amountMinor_non_negative"
  // (amountMinor >= 0), the partial unique index "PackagePrice_current_key" (one current price, retiredAt
  // IS NULL, per package and currency), and the "PackagePrice_immutable" trigger (packageId, currency,
  // amountMinor, and createdAt never change; retiredAt may be set once and never cleared or changed).
  @@index([packageId])
}

model PackageFeature {
  packageId String   @db.Uuid
  featureId String   @db.Uuid
  included  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([packageId, featureId])
  @@index([featureId])
}

model Template {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @db.Uuid
  key         String         @unique @db.VarChar(100)
  name        String         @db.VarChar(160)
  description String?        @db.Text
  status      TemplateStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  category Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions TemplateVersion[]

  @@index([categoryId])
}

model TemplateVersion {
  id            String                @id @default(uuid()) @db.Uuid
  templateId    String                @db.Uuid
  version       Int
  status        TemplateVersionStatus @default(DRAFT)
  componentKey  String                @map("component_key") @db.VarChar(100)
  schema        Json                  @db.JsonB
  configuration Json                  @db.JsonB
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)

  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // Migration 20261109120000 adds what Prisma cannot express: the partial unique index
  // "TemplateVersion_templateId_published_key" (one PUBLISHED version per template) and the
  // "TemplateVersion_status_transition" trigger (only DRAFT -> PUBLISHED and PUBLISHED -> RETIRED).
  @@unique([templateId, version])

  invitations Invitation[]
}

// A creator's invitation draft (M4 T1; S2, S3, S5, S10, A3). It is pinned at creation to the published
// template version it renders, the package its entitlements are checked against, and its public slug;
// none of those four ever changes. `content` is the bounded form data, always a JSON object.
// Migration 20261111214752_add_invitations adds what Prisma cannot express: the CHECK constraints
// "Invitation_slug_format", "Invitation_slug_length", "Invitation_content_object", and
// "Invitation_archivedAt_matches_status", and the "Invitation_pinned_fields_immutable" trigger.
// Migration 2026111*_add_invitation_publication adds "Invitation_publishedAt_matches_status" and keeps the
// archive check, which stays correct for three statuses.
// Migration 2026111*_add_invitation_features adds "timeZone" (NOT NULL with the default every existing row
// reads) and the one-to-one InvitationFeatureSettings table, plus the checks Prisma cannot express:
// "Invitation_timeZone_format" and "InvitationFeatureSettings_whatsappPhone_format".
model Invitation {
  id                String           @id @default(uuid()) @db.Uuid
  ownerId           String           @db.Uuid
  templateVersionId String           @db.Uuid
  packageId         String           @db.Uuid
  slug              String           @unique @db.VarChar(60)
  status            InvitationStatus @default(DRAFT)
  content           Json             @db.JsonB @default("{}")
  // The IANA zone the guest's countdown and calendar links use. The allow-list lives in the API domain
  // (`domain/invitation-features.ts`, S4); the database checks the shape and the default.
  timeZone          String           @default("America/Mexico_City") @db.VarChar(64)
  // RSVP settings (M6 G1; S4): an optional deadline and a party limit of 1 to 10. The deadline is nullable, so
  // every row that existed before the migration keeps accepting responses; the limit defaults to 4 and migration
  // 20261117120000_add_rsvp_responses adds the CHECK constraint Prisma cannot express.
  rsvpDeadline      DateTime?        @db.Timestamptz(6)
  rsvpPartyLimit    Int              @default(4)
  archivedAt        DateTime?        @db.Timestamptz(6)
  // Set exactly while the status is PUBLISHED: unpublishing and archiving clear it (S7, A2).
  publishedAt       DateTime?        @db.Timestamptz(6)
  // The first instant this invitation was ever published, or NULL while it never was (T2, S3). Unlike
  // `publishedAt`, nothing clears it: the refund rule reads it to refuse «Sin reembolso tras publicar» after an
  // unpublish or an archive. Migration 20261124120000_add_invitation_first_published_at adds it and the CHECK
  // constraint Prisma cannot express, `Invitation_firstPublishedAt_when_published`.
  firstPublishedAt  DateTime?        @db.Timestamptz(6)
  // Expiry the database carries but Milestone 5 never sets; the rule arrives in a later milestone (S8).
  expiresAt         DateTime?        @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(6)

  owner           User                      @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  templateVersion TemplateVersion           @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  package         Package                   @relation(fields: [packageId], references: [id], onDelete: Restrict)
  featureSettings InvitationFeatureSettings?
  places          InvitationPlace[]
  rsvpResponses   RsvpResponse[]
  guests          Guest[]
  mediaAssets     MediaAsset[]
  payments        Payment[]

  @@index([ownerId])
}

// Feature data of one invitation, stored apart from the template (F1; S3, S4): changing the template never
// touches it. The invitation id is the primary key, so an invitation has at most one row, and the foreign key
// is ON DELETE RESTRICT because an invitation is never hard-deleted here — archiving is the only terminal
// lifecycle write — matching every other invitation reference.
// Migration 2026111*_add_invitation_features adds what Prisma cannot express: the
// "InvitationFeatureSettings_whatsappPhone_format" check (NULL or an E.164 number, `^\+[1-9][0-9]{7,14}$`).
// Migration 2026111*_add_invitation_features_playlist_url adds "playlistUrl" and its
// "InvitationFeatureSettings_playlistUrl_https" check (NULL or a value that starts with `https://`).
// Migration 20261122120000_add_invitation_feature_music_metadata adds "playlistTitle" and "playlistCoverUrl",
// with "InvitationFeatureSettings_playlistCoverUrl_https" (NULL or a value that starts with `https://`).
model InvitationFeatureSettings {
  invitationId     String   @id @db.Uuid
  // E.164: `+` and eight to fifteen digits. Null while the owner has not set one (S4).
  whatsappPhone    String?  @db.VarChar(16)
  // The playlist link the guest's music button opens (F6; S7): an `https` URL on an allow-listed music host,
  // at most 500 characters, or NULL while the owner has not pasted one. The host allow-list is the API
  // domain's (`domain/invitation-features.ts`); the column checks the scheme and the width.
  playlistUrl      String?  @db.VarChar(500)
  // The title and the cover the provider's public oEmbed answer named when that link was saved, at most 200 and
  // 500 characters, or NULL when the provider named none or the lookup did not run (S2). The image-host
  // allow-list and the trimming are the API domain's; the cover column also checks the scheme.
  playlistTitle    String?  @db.VarChar(200)
  playlistCoverUrl String?  @db.VarChar(500)
  createdAt        DateTime @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
}

// The precise location of one address field of one invitation (S1, S2). The owner picks a suggestion from the
// geocoder, the address text is stored in the template content as always, and this row remembers the point the text
// referred to at that moment. It is keyed by the invitation and the content field name, so one address field has at
// most one point: a second choice replaces the first instead of adding another row. The reference is ON DELETE
// RESTRICT, because an invitation is never hard-deleted here (archiving is its only terminal lifecycle write).
// Migration 20261123120000_add_invitation_places adds what Prisma cannot express: the CHECK constraints
// "InvitationPlace_lat_range" (-90..90) and "InvitationPlace_lng_range" (-180..180). The public read shows a point
// only while the address text still equals `label` (domain/invitation-place.ts), so no column is dropped on rewrite.
model InvitationPlace {
  invitationId String   @db.Uuid
  // The content field name of the address, such as `address` or `ceremonyAddress` (S2); the API derives it from the
  // pinned template version schema and never from a template name.
  field        String   @db.VarChar(64)
  // The label the geocoder answered when the owner chose the suggestion, at most 300 characters. It is the text the
  // content field holds at that moment, which is what makes a later rewrite drop the point.
  label        String   @db.VarChar(300)
  // The point, range-checked by the migration's CHECK constraints; the domain refuses the same bounds first.
  lat          Float    @db.DoublePrecision
  lng          Float    @db.DoublePrecision
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@id([invitationId, field])
}

// One guest's attendance answer to one invitation (M6 G1; S1, S4). The row is tied to the invitation, which is
// never hard-deleted here (archiving is its only terminal lifecycle write), so the reference is ON DELETE RESTRICT.
// `dedupeKey` is the normalized name and normalized phone: the unique index on `(invitationId, dedupeKey)` is what
// makes an open-form retry an update instead of a duplicate and what lets two concurrent identical submissions end
// in one row. A personal-link answer instead carries `guestId` (`guest|<guestId>` as its dedupe key) and upserts on
// that unique column, which the guest table and its nullable reference arrive with (M6 G2).
// The response carries bounded values only — a name of 1 to 80 characters, an attending flag, a party size of 0 to
// 10 (0 exactly when declined), an optional E.164 phone, an optional message of at most 280 characters, and the
// timestamps — and no free-form JSONB.
// Migration 20261117120000_add_rsvp_responses adds what Prisma cannot express: the CHECK constraints
// "RsvpResponse_name_length", "RsvpResponse_partySize_range", "RsvpResponse_partySize_matches_attending",
// "RsvpResponse_phone_format", and "RsvpResponse_message_length", plus "Invitation_rsvpPartyLimit_range".
model RsvpResponse {
  id           String   @id @default(uuid()) @db.Uuid
  invitationId String   @db.Uuid
  // The guest a personal-link answer belongs to, or NULL for an answer to the open form (M6 G2; S4). The unique
  // index on this column is what makes one guest have at most one answer; the foreign key is ON DELETE RESTRICT
  // and the guest's own removal deletes the answer in the same statement.
  guestId      String?  @unique @db.Uuid
  // The dedupe-normalized name and the normalized phone, separated by `|` (at most 97 characters).
  dedupeKey    String   @db.VarChar(200)
  name         String   @db.VarChar(80)
  attending    Boolean
  // 0 when the guest declined; otherwise 1 to the invitation's `rsvpPartyLimit` (the domain checks the limit).
  partySize    Int
  // E.164 or NULL; the domain normalizes a Mexican ten-digit number to `+52…` like the WhatsApp contact does.
  phone        String?  @db.VarChar(16)
  message      String?  @db.VarChar(280)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  guest      Guest?     @relation(fields: [guestId], references: [id], onDelete: Restrict)

  @@unique([invitationId, dedupeKey])
}

// One uploaded photo of one invitation (M8 S4). The binary never lives here: `storageKey` names the object in the
// storage adapter, and it is unique because it embeds the generated asset id. `kind` is `main-photo` (at most one
// current per invitation, enforced by the partial unique index the migration adds) or `gallery` (ordered by
// `position`, at most 12 stored); an invitation holds at most 40 stored assets, enforced by the application in the
// transaction that writes a row, serialized on the invitation. `alt` is optional and at most 120 characters.
// Migration 20261120120000_add_media_assets adds what Prisma cannot express: the CHECK constraints
// "MediaAsset_byteSize_range", "MediaAsset_dimensions_range", "MediaAsset_mime_webp",
// "MediaAsset_position_matches_kind", "MediaAsset_alt_length", and "MediaAsset_storageKey_format", plus the partial
// unique index "MediaAsset_one_stored_main_photo" and the index on (invitationId, kind, status, position).
model MediaAsset {
  id           String           @id @default(uuid()) @db.Uuid
  invitationId String           @db.Uuid
  kind         MediaAssetKind
  // `invitations/<invitationId>/<assetId>.webp`: built by the API from validated ids only (S4).
  storageKey   String           @unique @db.VarChar(200)
  mime         String           @default("image/webp") @db.VarChar(64)
  byteSize     Int
  width        Int
  height       Int
  // The gallery order; NULL for the one main photo (S4). The CHECK keeps the two kinds apart.
  position     Int?
  alt          String?          @db.VarChar(120)
  status       MediaAssetStatus @default(STORED)
  createdAt    DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime         @updatedAt @db.Timestamptz(6)

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)

  @@index([invitationId, kind, status, position])
}

// One person on an invitation's guest list (M6 G2; S1, S3, S4). The owner reaches a guest only through the
// invitation that pins the package granting `GUEST_LIST`, so there is no owner column here: the adapter's every
// statement joins the invitation and names its owner. `tokenHash` is the SHA-256 hex digest of the guest's personal
// token, the only form ever stored, and its unique index is what a personal link is looked up through. The token
// itself is 128 bits drawn by the platform's cryptographic random source and is answered once, on creation or
// rotation. The row carries bounded values only: a name of 1 to 80 characters, 1 to 10 seats, an optional E.164
// phone, an optional note of at most 200 characters, and the check-in instant the owner's QR scan sets once.
// Migration 20261118120000_add_guests adds what Prisma cannot express: the CHECK constraints
// "Guest_name_length", "Guest_seats_range", "Guest_phone_format", "Guest_note_length", and
// "Guest_tokenHash_format", plus the RsvpResponse "guestId" column and its unique index.
model Guest {
  id            String    @id @default(uuid()) @db.Uuid
  invitationId  String    @db.Uuid
  name          String    @db.VarChar(80)
  // The party this guest may confirm, 1 to 10; the domain refuses anything else.
  seats         Int
  phone         String?   @db.VarChar(16)
  note          String?   @db.VarChar(200)
  // The SHA-256 hex digest of the personal token: the only form stored, unique, and what a link looks up.
  tokenHash     String    @unique @db.VarChar(64)
  tokenIssuedAt DateTime  @db.Timestamptz(6)
  // When the owner first checked this guest in, or NULL while not checked in. A repeated scan keeps the first.
  checkedInAt   DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(6)

  invitation   Invitation    @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  rsvpResponse RsvpResponse?

  @@index([invitationId])
}

// One checkout intent for one invitation (M7 S1, S4). `amountMinor` and `currency` are the snapshot of the
// package's price at the moment the payment was created: the catalog may retire that price and publish another,
// and this row keeps the amount the owner actually saw. `provider` is the adapter key (never a credential) and
// `providerReference` is the provider's own identifier of the checkout, unique per provider and NULL until the
// adapter has created it. `idempotencyKey` is the server-generated key the adapter passes so a retried checkout
// asks the provider for the same session instead of a second one. `paidAt` is the API's own receipt instant (the
// instant a verified `paid` event was applied), never a provider-supplied time in a money-relevant column.
// Migration 20261121120000_add_payments adds what Prisma cannot express: the CHECK constraints
// "Payment_amountMinor_non_negative", "Payment_currency_format", and "Payment_paidAt_matches_status", and the
// partial unique index "Payment_one_pending_key" (one `pending` payment per invitation) that makes two
// simultaneous checkouts converge on one row.
model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  invitationId      String        @db.Uuid
  // The package whose price this payment bought; the entitlement rule requires this to match the invitation's.
  packageId         String        @db.Uuid
  amountMinor       Int
  currency          String        @db.Char(3)
  status            PaymentStatus @default(pending)
  provider          String        @db.VarChar(40)
  providerReference String?       @db.VarChar(200)
  idempotencyKey    String        @unique @db.VarChar(100)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)
  paidAt            DateTime?     @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @db.Timestamptz(6)

  invitation Invitation     @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  package    Package        @relation(fields: [packageId], references: [id], onDelete: Restrict)
  events     PaymentEvent[]

  @@unique([provider, providerReference])
  @@index([invitationId, status])
}

// One received provider event (M7 S1, S4): the normalized type, the provider's own event id, when the API received
// and processed it, what the intake decided, and the SHA-256 hex digest of the raw payload. The raw payload is
// never stored: it can carry a payer's name, e-mail address, or card metadata, and the normalized event plus the
// digest is everything a replay investigation needs. `(provider, providerEventId)` is unique, so a retried or
// duplicated delivery inserts nothing and is answered as a no-op. `paymentId` is NULL for a signed event about a
// provider reference this API does not know, which is recorded and ignored rather than dropped.
// Migration 20261121120000_add_payments adds what Prisma cannot express: the CHECK constraints
// "PaymentEvent_outcome_allowed", "PaymentEvent_type_allowed", and "PaymentEvent_payloadSha256_format" (a
// lowercase SHA-256 hex digest), plus the index on `paymentId`.
model PaymentEvent {
  id              String    @id @default(uuid()) @db.Uuid
  paymentId       String?   @db.Uuid
  provider        String    @db.VarChar(40)
  providerEventId String    @db.VarChar(200)
  type            String    @db.VarChar(40)
  receivedAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt     DateTime? @db.Timestamptz(6)
  // The decision the intake took for this delivery, written when the row is inserted and corrected to
  // `ignored_transition` if a concurrent delivery won the guarded transition.
  outcome         String    @db.VarChar(40)
  payloadSha256   String    @db.Char(64)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([paymentId])
}
