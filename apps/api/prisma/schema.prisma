generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum PackageStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String     @unique @db.VarChar(320)
  displayName String?    @db.VarChar(120)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  key         String     @unique @db.VarChar(100)
  name        String     @db.VarChar(120)
  description String?    @db.Text
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @db.Timestamptz(6)
  templates   Template[]
}

model Feature {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  packageFeatures PackageFeature[]
}

model Package {
  id              String           @id @default(uuid()) @db.Uuid
  key             String           @unique @db.VarChar(100)
  name            String           @db.VarChar(120)
  description     String?          @db.Text
  status          PackageStatus    @default(DRAFT)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)
  packageFeatures PackageFeature[]
}

model PackageFeature {
  packageId String   @db.Uuid
  featureId String   @db.Uuid
  included  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Restrict)

  @@id([packageId, featureId])
  @@index([featureId])
}

model Template {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @db.Uuid
  key         String         @unique @db.VarChar(100)
  name        String         @db.VarChar(160)
  description String?        @db.Text
  status      TemplateStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime       @updatedAt @db.Timestamptz(6)

  category Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  versions TemplateVersion[]

  @@index([categoryId])
}

model TemplateVersion {
  id            String                @id @default(uuid()) @db.Uuid
  templateId    String                @db.Uuid
  version       Int
  status        TemplateVersionStatus @default(DRAFT)
  componentKey  String                @map("component_key") @db.VarChar(100)
  schema        Json                  @db.JsonB
  configuration Json                  @db.JsonB
  createdAt     DateTime              @default(now()) @db.Timestamptz(6)

  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@unique([templateId, version])
}
